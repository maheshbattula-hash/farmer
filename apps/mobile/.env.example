# ── API Connection ────────────────────────────────────────────────────────────
# The URL the mobile app uses to reach the backend API.
# Use your machine's LAN IP (e.g. http://192.168.x.x:8000) when testing on a
# physical device, or http://localhost:8000 for emulators.
EXPO_PUBLIC_API_URL=http://localhost:8000
