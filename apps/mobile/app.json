{
  "expo": {
    "name": "Smart Farmer Platform",
    "slug": "smart-farmer-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/splash-light.png",
    "splash": {
      "image": "./assets/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f1",
      "dark": {
        "image": "./assets/splash-dark.png",
        "backgroundColor": "#102116"
      }
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "resizeMode": "cover",
          "backgroundColor": "#f7f6f1",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#102116"
          }
        }
      ]
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartfarmer.platform",
      "splash": {
        "image": "./assets/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#f7f6f1",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#102116"
        }
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Smart Farmer uses the camera to capture crop images for disease prediction.",
        "NSPhotoLibraryUsageDescription": "Smart Farmer uses your photo library to attach crop images.",
        "NSLocationWhenInUseUsageDescription": "Smart Farmer uses your location to find nearby buyers and show local demand.",
        "NSUserNotificationsUsageDescription": "Smart Farmer uses notifications for order and market alerts."
      }
    },

    "android": {
      "package": "com.smartfarmer.platform",
      "splash": {
        "image": "./assets/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#f7f6f1",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#102116"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },

    "web": {
      "bundler": "metro"
    }
  }
}
